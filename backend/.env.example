# MiroFish-Offline Environment Configuration
# Copy this file to .env and fill in your values.
# Generate a secret key: python -c "import secrets; print(secrets.token_hex(32))"

# ==========================================
# Flask
# ==========================================
SECRET_KEY=
FLASK_DEBUG=True

# ==========================================
# CORS - Comma-separated list of allowed origins
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# LLM (Ollama - local default)
# ==========================================
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b

# ==========================================
# Neo4j Graph Database
# ==========================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ==========================================
# Embedding Model (Ollama)
# ==========================================
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434

# ==========================================
# Cloud Providers (optional - only used in hybrid_safe or cloud_quality modes)
# ==========================================
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
NVIDIA_API_KEY=

# ==========================================
# OASIS Simulation
# ==========================================
OASIS_DEFAULT_MAX_ROUNDS=10
REPORT_AGENT_MAX_TOOL_CALLS=5
REPORT_AGENT_MAX_REFLECTION_ROUNDS=2
REPORT_AGENT_TEMPERATURE=0.5
