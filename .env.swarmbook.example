# Swarmbook local-first environment (PLACEHOLDERS ONLY)
#
# Do not commit real API keys. Set them only in your local shell or a local .env file
# excluded by .gitignore.

# Backend
FLASK_ENV=development
FLASK_DEBUG=1

# Backend listen port is controlled by start scripts, but you can set defaults here.
MIROFISH_BACKEND_PORT=5001

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=8192

# Neo4j (local)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# Swarmbook provider routing
BOOK_SIM_PROVIDER_TIMEOUT=30

# Optional external providers (only used when privacy/profile allows it)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=your_nvidia_base_url_here
NVIDIA_EMBEDDING_MODEL=your_nvidia_embedding_model_here

